{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Customer lead or existing client information.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "usageType": { "type": "string", "enum": ["residential", "commercial", "industrial"] },
        "phaseType": { "type": "string", "enum": ["1phase", "3phase"] },
        "assignedSalesId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["new", "contacted", "survey", "negotiating", "won", "lost"] },
        "source": { "type": "string", "enum": ["facebook", "google", "referral", "hotline", "other"] },
        "leadValue": { "type": "number" }
      },
      "required": ["name", "phone"]
    },
    "CustomerInteraction": {
      "title": "Customer Interaction",
      "description": "An action or meeting with the customer.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "type": { "type": "string", "enum": ["call", "meeting", "note", "email", "survey"] },
        "content": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "type", "content", "userId", "userName"]
    },
    "CustomerReminder": {
      "title": "Customer Reminder",
      "description": "Tasks or events associated with a customer lead.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "assignedToId": { "type": "string" },
        "title": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "title", "status"]
    },
    "SalesPerson": {
      "title": "Sales Person",
      "description": "Company sales staff member.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["sales_rep", "sales_manager"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Solar panels, inverters, and branding information.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["panel", "inverter", "battery", "mounting", "accessory", "other"] },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "capacity": { "type": "number", "description": "Wattage for panels, kW for inverters" },
        "unitPrice": { "type": "number" },
        "isThreePhase": { "type": "boolean" },
        "specifications": { "type": "object" }
      },
      "required": ["type", "brand", "model", "unitPrice"]
    },
    "Project": {
      "title": "Project",
      "description": "A solar project containing configuration, financial analysis, and status.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "status": { "type": "string", "enum": ["lead", "survey", "proposal", "contract", "installation", "completed"] },
        "currentPhase": { "type": "string" },
        "progress": { "type": "number" },
        "monthlyBill": { "type": "number", "description": "Average monthly electricity bill in VND" },
        "systemSizeKWp": { "type": "number" },
        "assignedSalesId": { "type": "string" },
        "assignedOperatorId": { "type": "string" },
        "panels": { "type": "object", "properties": { "equipmentId": { "type": "string" }, "count": { "type": "number" } } },
        "inverters": { "type": "object", "properties": { "equipmentId": { "type": "string" }, "count": { "type": "number" } } },
        "batteries": { "type": "object", "properties": { "equipmentId": { "type": "string" }, "count": { "type": "number" } } },
        "totalCost": { "type": "number" },
        "annualProduction": { "type": "number", "description": "Estimated kWh per year" },
        "paybackYears": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "status", "progress"]
    },
    "ProjectTask": {
      "title": "Project Task",
      "description": "Execution tasks for project phases",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "assignedToId": { "type": "string" },
        "creatorId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "phase": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["todo", "in_progress", "review", "done"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "title", "status", "creatorId"]
    },
    "ProjectActivity": {
      "title": "Project Activity",
      "description": "History log for project events",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["status_change", "task_update", "comment", "file_upload"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "userId", "type", "description"]
    },
    "SalesTask": {
      "title": "Sales Task",
      "description": "Activities assigned to sales staff for a project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "assignedSalesId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "completed"] }
      },
      "required": ["projectId", "title"]
    },
    "AppUser": {
      "title": "App User",
      "description": "User profile with role and status.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "manager", "sales_rep", "operator"] },
        "displayName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "pending"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "email", "role", "status"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global application configuration.",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "companyName": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "website": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time notifications for newly added customers, tasks, or appointments.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["customer", "appointment", "task"] },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "type", "createdBy", "createdByName"]
    }
  },
  "firestore": {
    "notifications": {
      "schema": "Notification",
      "description": "Log of staff-generated real-time system alerts."
    },
    "customers": {
      "schema": "Customer",
      "description": "Collection of customer leads."
    },
    "customers/{customerId}/interactions": {
      "schema": "CustomerInteraction",
      "description": "Call logs, notes, and surveys for this customer."
    },
    "customers/{customerId}/reminders": {
      "schema": "CustomerReminder",
      "description": "Reminders and tasks to do for this customer."
    },
    "equipment": {
      "schema": "Equipment",
      "description": "Catalog of available solar equipment."
    },
    "projects": {
      "schema": "Project",
      "description": "Collection of solar installation projects."
    },
    "sales": {
      "schema": "SalesPerson",
      "description": "Company sales staff."
    },
    "salesTasks": {
      "schema": "SalesTask",
      "description": "Tasks for sales staff."
    },
    "users": {
        "schema": "AppUser",
        "description": "Application user profiles and permissions."
    },
    "settings": {
      "schema": "SystemSettings",
      "description": "Global settings for the application."
    }
  }
}
