rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Auth tokens NEVER contain custom claims (e.g., request.auth.token.role or admin).
    // We explicitly look up roles using get() or exists() on the users collection.
    function hAdmin(db, auth) {
      return auth != null && 
        exists(/databases/$(database)/documents/users/$(auth.uid)) && 
        (get(/databases/$(database)/documents/users/$(auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(auth.uid)).data.role == 'manager');
    }

    function hActive(db, auth) {
      return auth != null && 
        exists(/databases/$(database)/documents/users/$(auth.uid)) && 
        get(/databases/$(database)/documents/users/$(auth.uid)).data.status == 'active';
    }

    function isSalesRep(db, auth) {
      return auth != null && 
        exists(/databases/$(database)/documents/users/$(auth.uid)) && 
        get(/databases/$(database)/documents/users/$(auth.uid)).data.role == 'sales_rep';
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- VALIDATION BLUEPRINTS ---
    
    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
          && (!('usageType' in data) || data.usageType in ['residential', 'commercial', 'industrial'])
          && (!('phaseType' in data) || data.phaseType in ['1phase', '3phase'])
          && (!('email' in data) || data.email is string)
          && (!('address' in data) || data.address is string)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('createdAt' in data) || data.createdAt is timestamp)
          && (!('updatedAt' in data) || data.updatedAt is timestamp)
          && (!('id' in data) || data.id is string)
          && (!('status' in data) || data.status in ['new', 'contacted', 'survey', 'negotiating', 'won', 'lost'])
          && (!('source' in data) || data.source in ['facebook', 'google', 'referral', 'hotline', 'other'])
          && (!('leadValue' in data) || data.leadValue is number);
    }

    function isValidInteraction(data, auth) {
      return data.customerId is string && data.customerId.size() > 0
          && data.type in ['call', 'meeting', 'note', 'email', 'survey']
          && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
          && data.userId == auth.uid
          && data.userName is string && data.userName.size() > 0
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidReminder(data) {
      return data.customerId is string && data.customerId.size() > 0
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.status in ['pending', 'completed']
          && (!('dueDate' in data) || data.dueDate is string || data.dueDate is timestamp)
          && (!('assignedToId' in data) || isValidId(data.assignedToId) || data.assignedToId == "")
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidEquipment(data) {
      return data.brand is string && data.brand.size() > 0
          && data.model is string && data.model.size() > 0
          && data.type in ['panel', 'inverter', 'battery', 'mounting', 'accessory', 'other']
          && data.unitPrice is number && data.unitPrice >= 0
          && (!('capacity' in data) || data.capacity is number)
          && (!('isThreePhase' in data) || data.isThreePhase is bool)
          && (!('id' in data) || data.id is string);
    }

    function isValidProject(data) {
      return isValidId(data.customerId)
          && data.status in ['lead', 'survey', 'proposal', 'contract', 'installation', 'completed']
          && (data.systemSizeKWp is number || (data.systemSizeKWp is string && (data.systemSizeKWp == "" || data.systemSizeKWp == "0")))
          && (!('monthlyBill' in data) || data.monthlyBill is number)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('totalCost' in data) || data.totalCost is number)
          && (!('annualProduction' in data) || data.annualProduction is number)
          && (!('paybackYears' in data) || data.paybackYears is number)
          && (!('panels' in data) || (data.panels.equipmentId is string && data.panels.count is number))
          && (!('inverters' in data) || (data.inverters.equipmentId is string && data.inverters.count is number))
          && (!('batteries' in data) || (data.batteries.equipmentId is string && data.batteries.count is number))
          && (!('updatedAt' in data) || data.updatedAt is timestamp)
          && (!('id' in data) || data.id is string);
    }

    function isValidSalesPerson(data) {
      return data.name is string && data.name.size() > 0
          && data.email is string && data.email.size() > 0
          && data.role in ['sales_rep', 'sales_manager']
          && (!('phone' in data) || data.phone is string)
          && (!('id' in data) || data.id is string)
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidSalesTask(data) {
      return isValidId(data.projectId)
          && data.title is string && data.title.size() > 0
          && data.status in ['pending', 'completed']
          && (!('description' in data) || data.description is string)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('id' in data) || data.id is string)
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidUser(data) {
      return data.username is string && data.username.size() > 0
          && data.email is string && data.email.size() > 0
          && data.role in ['admin', 'manager', 'sales_rep', 'operator']
          && data.status in ['active', 'inactive', 'pending']
          && (!('displayName' in data) || data.displayName is string)
          && (!('phone' in data) || data.phone is string)
          && (!('region' in data) || data.region is string)
          && (!('createdAt' in data) || data.createdAt is timestamp)
          && (!('lastLogin' in data) || data.lastLogin is timestamp || data.lastLogin == null)
          && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt == null)
          && (!('id' in data) || data.id is string);
    }

    function isValidSettings(data) {
      return (!('logoUrl' in data) || data.logoUrl is string)
          && (!('companyName' in data) || data.companyName is string)
          && (!('address' in data) || data.address is string)
          && (!('phone' in data) || data.phone is string)
          && (!('website' in data) || data.website is string)
          && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // --- RULES ---

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_test_/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || hAdmin(database, request.auth)) && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'displayName', 'username', 'updatedAt', 'phone', 'region'])) ||
        hAdmin(database, request.auth)
      ) && isValidUser(incoming());
    }

    match /customers/{customerId} {
      allow read: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || resource.data.assignedSalesId == request.auth.uid);
      allow create: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || incoming().assignedSalesId == request.auth.uid) && isValidCustomer(incoming());
      allow update: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) || 
        (existing().assignedSalesId == request.auth.uid && incoming().assignedSalesId == request.auth.uid)
      ) && isValidCustomer(incoming());
      allow delete: if hActive(database, request.auth) && hAdmin(database, request.auth);

      match /interactions/{interactionId} {
        allow read: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || get(/databases/$(database)/documents/customers/$(customerId)).data.assignedSalesId == request.auth.uid);
        allow create: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || get(/databases/$(database)/documents/customers/$(customerId)).data.assignedSalesId == request.auth.uid) && isValidInteraction(incoming(), request.auth);
        allow update, delete: if hActive(database, request.auth) && (hAdmin(database, request.auth) || resource.data.userId == request.auth.uid);
      }
    }

    match /{path=**}/reminders/{reminderId} {
      allow read: if isSignedIn();
      allow create: if hActive(database, request.auth) && isValidReminder(incoming());
      allow update: if hActive(database, request.auth) && isValidReminder(incoming());
      allow delete: if hActive(database, request.auth);
    }

    match /equipment/{equipmentId} {
      allow read: if isSignedIn();
      allow create, update: if hActive(database, request.auth) && hAdmin(database, request.auth) && isValidEquipment(incoming());
      allow delete: if hActive(database, request.auth) && hAdmin(database, request.auth);
    }

    match /projects/{projectId} {
      allow read: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || resource.data.assignedSalesId == request.auth.uid);
      allow create: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || incoming().assignedSalesId == request.auth.uid) && isValidProject(incoming());
      allow update: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) || 
        (existing().assignedSalesId == request.auth.uid && incoming().assignedSalesId == request.auth.uid)
      ) && isValidProject(incoming());
      allow delete: if hActive(database, request.auth) && hAdmin(database, request.auth);
    }

    function isValidProjectTask(data, auth) {
      return isValidId(data.projectId)
          && data.title is string && data.title.size() > 0
          && data.status in ['todo', 'in_progress', 'review', 'done']
          && (!('assignedToId' in data) || isValidId(data.assignedToId))
          && data.creatorId == auth.uid;
    }

    match /projectTasks/{taskId} {
      allow read: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || resource.data.assignedToId == request.auth.uid);
      allow create: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || incoming().assignedToId == request.auth.uid) && isValidProjectTask(incoming(), request.auth);
      allow update: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) || 
        (existing().assignedToId == request.auth.uid && incoming().assignedToId == request.auth.uid)
      );
      allow delete: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) || 
        (!isSalesRep(database, request.auth) && resource.data.creatorId == request.auth.uid)
      );
    }

    function isValidProjectActivity(data, auth) {
      return isValidId(data.projectId)
          && data.userId == auth.uid
          && data.type in ['status_change', 'task_update', 'comment', 'file_upload']
          && data.description is string && data.description.size() > 0;
    }

    match /projectActivities/{activityId} {
      allow read: if hActive(database, request.auth);
      allow create: if hActive(database, request.auth) && isValidProjectActivity(incoming(), request.auth);
      allow update, delete: if false; // Activities are immutable logs
    }

    match /sales/{salesId} {
      allow read: if hActive(database, request.auth);
      allow create: if hActive(database, request.auth) && hAdmin(database, request.auth) && isValidSalesPerson(incoming());
      allow update: if hActive(database, request.auth) && hAdmin(database, request.auth) && isValidSalesPerson(incoming());
      allow delete: if hActive(database, request.auth) && hAdmin(database, request.auth);
    }

    match /salesTasks/{taskId} {
      allow read: if hActive(database, request.auth);
      allow create: if hActive(database, request.auth) && isValidSalesTask(incoming());
      allow update: if hActive(database, request.auth) && isValidSalesTask(incoming());
      allow delete: if hActive(database, request.auth) && hAdmin(database, request.auth);
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if hActive(database, request.auth) && hAdmin(database, request.auth) && isValidSettings(incoming());
    }
  }
}
