rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- VALIDATION BLUEPRINTS ---
    
    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
          && (!('usageType' in data) || data.usageType in ['residential', 'commercial', 'industrial'])
          && (!('phaseType' in data) || data.phaseType in ['1phase', '3phase'])
          && (!('email' in data) || data.email is string)
          && (!('address' in data) || data.address is string)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('createdAt' in data) || data.createdAt is timestamp)
          && (!('id' in data) || data.id is string);
    }

    function isValidEquipment(data) {
      return data.brand is string && data.brand.size() > 0
          && data.model is string && data.model.size() > 0
          && data.type in ['panel', 'inverter', 'battery', 'mounting', 'accessory', 'other']
          && data.unitPrice is number && data.unitPrice >= 0
          && (!('capacity' in data) || data.capacity is number)
          && (!('id' in data) || data.id is string);
    }

    function isValidProject(data) {
      return isValidId(data.customerId)
          && data.status in ['lead', 'survey', 'proposal', 'contract', 'installation', 'completed']
          && (data.systemSizeKWp is number || (data.systemSizeKWp is string && (data.systemSizeKWp == "" || data.systemSizeKWp == "0")))
          && (!('monthlyBill' in data) || data.monthlyBill is number)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('totalCost' in data) || data.totalCost is number)
          && (!('annualProduction' in data) || data.annualProduction is number)
          && (!('paybackYears' in data) || data.paybackYears is number)
          && (!('panels' in data) || (data.panels.equipmentId is string && data.panels.count is number))
          && (!('inverters' in data) || (data.inverters.equipmentId is string && data.inverters.count is number))
          && (!('batteries' in data) || (data.batteries.equipmentId is string && data.batteries.count is number))
          && (!('updatedAt' in data) || data.updatedAt is timestamp)
          && (!('id' in data) || data.id is string);
    }

    function isValidSalesPerson(data) {
      return data.name is string && data.name.size() > 0
          && data.email is string && data.email.size() > 0
          && data.role in ['sales_rep', 'sales_manager']
          && (!('phone' in data) || data.phone is string)
          && (!('id' in data) || data.id is string)
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidSalesTask(data) {
      return isValidId(data.projectId)
          && data.title is string && data.title.size() > 0
          && data.status in ['pending', 'completed']
          && (!('description' in data) || data.description is string)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('id' in data) || data.id is string)
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidUser(data) {
      return data.username is string && data.username.size() > 0
          && data.email is string && data.email.size() > 0
          && data.role in ['admin', 'manager', 'sales_rep']
          && data.status in ['active', 'inactive']
          && (!('displayName' in data) || data.displayName is string)
          && (!('createdAt' in data) || data.createdAt is timestamp)
          && (!('lastLogin' in data) || data.lastLogin is timestamp)
          && (!('updatedAt' in data) || data.updatedAt is timestamp)
          && (!('id' in data) || data.id is string);
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- RULES ---

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_test_/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'displayName', 'username', 'updatedAt'])) ||
        isAdmin()
      ) && isValidUser(incoming());
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidCustomer(incoming());
      allow update: if isSignedIn() && isValidCustomer(incoming());
      allow delete: if isSignedIn();
    }

    match /equipment/{equipmentId} {
      allow read: if true; // Catalog open to view
      allow write: if isSignedIn() && isValidEquipment(incoming());
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidProject(incoming());
      allow update: if isSignedIn() && isValidProject(incoming());
      allow delete: if isSignedIn();
    }

    match /sales/{salesId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSalesPerson(incoming());
      allow update: if isSignedIn() && isValidSalesPerson(incoming());
      allow delete: if isSignedIn();
    }

    match /salesTasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSalesTask(incoming());
      allow update: if isSignedIn() && isValidSalesTask(incoming());
      allow delete: if isSignedIn();
    }
  }
}
