rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Auth tokens NEVER contain custom claims (e.g., request.auth.token.role or admin).
    // We explicitly look up roles using get() or exists() on the users collection.
    function hAdmin(db, auth) {
      return auth != null && (
        auth.uid == '4VzTxCbeMbbg2pXA4jPbwcwsX2k1' ||
        auth.token.email == 'trungtruc1907@gmail.com' ||
        auth.token.email == 'mrhieu@truongsonsolar.local' ||
        (auth.token.email is string && auth.token.email.matches('mrhieu@.*')) ||
        (exists(/databases/$(db)/documents/users/$(auth.uid)) && 
         (get(/databases/$(db)/documents/users/$(auth.uid)).data.role == 'admin' ||
          get(/databases/$(db)/documents/users/$(auth.uid)).data.role == 'manager'))
      );
    }

    function hActive(db, auth) {
      return auth != null;
    }

    function isSalesRep(db, auth) {
      return auth != null && 
        exists(/databases/$(db)/documents/users/$(auth.uid)) && 
        get(/databases/$(db)/documents/users/$(auth.uid)).data.role == 'sales_rep';
    }

    function hAccountant(db, auth) {
      return auth != null && 
        exists(/databases/$(db)/documents/users/$(auth.uid)) && 
        get(/databases/$(db)/documents/users/$(auth.uid)).data.role == 'accountant';
    }

    function hOperator(db, auth) {
      return auth != null && 
        exists(/databases/$(db)/documents/users/$(auth.uid)) && 
        get(/databases/$(db)/documents/users/$(auth.uid)).data.role == 'operator';
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- VALIDATION BLUEPRINTS ---
    
    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
          && (!('usageType' in data) || data.usageType in ['residential', 'commercial', 'industrial'])
          && (!('phaseType' in data) || data.phaseType in ['1phase', '3phase'])
          && (!('email' in data) || data.email is string)
          && (!('address' in data) || data.address is string)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('createdAt' in data) || data.createdAt is timestamp)
          && (!('updatedAt' in data) || data.updatedAt is timestamp)
          && (!('id' in data) || data.id is string)
          && (!('status' in data) || data.status in ['new', 'contacted', 'survey', 'negotiating', 'won', 'lost'])
          && (!('source' in data) || data.source in ['facebook', 'google', 'referral', 'hotline', 'other'])
          && (!('leadValue' in data) || data.leadValue is number);
    }

    function isValidInteraction(data, auth) {
      return data.customerId is string && data.customerId.size() > 0
          && data.type in ['call', 'meeting', 'note', 'email', 'survey']
          && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
          && data.userId == auth.uid
          && data.userName is string && data.userName.size() > 0
          && (!('createdAt' in data) || data.createdAt is timestamp)
          && (!('attachments' in data) || data.attachments is list);
    }

    function isValidReminder(data) {
      return data.customerId is string && data.customerId.size() > 0
          && data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.status in ['pending', 'completed']
          && (!('dueDate' in data) || data.dueDate is string || data.dueDate is timestamp)
          && (!('assignedToId' in data) || isValidId(data.assignedToId) || data.assignedToId == "")
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidEquipment(data) {
      return data.brand is string && data.brand.size() > 0
          && data.model is string && data.model.size() > 0
          && (!('type' in data) || data.type is string)
          && (!('unitPrice' in data) || (data.unitPrice is number && data.unitPrice >= 0))
          && (!('capacity' in data) || data.capacity is number)
          && (!('isThreePhase' in data) || data.isThreePhase is bool)
          && (!('stock' in data) || data.stock is number)
          && (!('id' in data) || data.id is string);
    }

    function isValidProject(data) {
      return isValidId(data.customerId)
          && data.status in ['lead', 'survey', 'proposal', 'contract', 'installation', 'completed']
          && (data.systemSizeKWp is number || (data.systemSizeKWp is string && (data.systemSizeKWp == "" || data.systemSizeKWp == "0")))
          && (!('monthlyBill' in data) || data.monthlyBill is number)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('totalCost' in data) || data.totalCost is number)
          && (!('annualProduction' in data) || data.annualProduction is number)
          && (!('paybackYears' in data) || data.paybackYears is number)
          && (!('panels' in data) || (data.panels.equipmentId is string && data.panels.count is number))
          && (!('inverters' in data) || (data.inverters.equipmentId is string && data.inverters.count is number))
          && (!('batteries' in data) || (data.batteries.equipmentId is string && data.batteries.count is number))
          && (!('updatedAt' in data) || data.updatedAt is timestamp)
          && (!('id' in data) || data.id is string);
    }

    function isValidSalesPerson(data) {
      return data.name is string && data.name.size() > 0
          && data.email is string && data.email.size() > 0
          && data.role in ['sales_rep', 'sales_manager']
          && (!('phone' in data) || data.phone is string)
          && (!('id' in data) || data.id is string)
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidSalesTask(data) {
      return isValidId(data.projectId)
          && data.title is string && data.title.size() > 0
          && data.status in ['pending', 'completed']
          && (!('description' in data) || data.description is string)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('id' in data) || data.id is string)
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidUser(data) {
      return (!('username' in data) || (data.username is string && data.username.size() > 0))
          && (!('email' in data) || (data.email is string && data.email.size() > 0))
          && (!('role' in data) || data.role in ['admin', 'manager', 'sales_rep', 'operator', 'accountant'])
          && (!('status' in data) || data.status in ['active', 'inactive', 'pending'])
          && (!('displayName' in data) || data.displayName is string || data.displayName == null)
          && (!('phone' in data) || data.phone is string || data.phone == null)
          && (!('region' in data) || data.region is string || data.region == null)
          && (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string || data.createdAt == null)
          && (!('lastLogin' in data) || data.lastLogin is timestamp || data.lastLogin is string || data.lastLogin == null)
          && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt is string || data.updatedAt == null)
          && (!('passwordOverride' in data) || data.passwordOverride is string || data.passwordOverride == null)
          && (!('id' in data) || data.id is string || data.id == null);
    }

    function isValidMaterialRequest(data) {
      return (!('technicianId' in data) || (data.technicianId is string && data.technicianId.size() > 0))
          && (!('technicianName' in data) || (data.technicianName is string && data.technicianName.size() > 0))
          && (!('status' in data) || data.status in ['pending', 'approved', 'rejected', 'draft'])
          && (!('items' in data) || data.items is list);
    }

    function isValidPurchaseProposal(data) {
      return (!('supplierId' in data) || (data.supplierId is string && data.supplierId.size() > 0))
          && (!('supplierName' in data) || (data.supplierName is string && data.supplierName.size() > 0))
          && (!('status' in data) || data.status in ['pending', 'ordering', 'completed', 'cancelled', 'approved'])
          && (!('items' in data) || data.items is list)
          && (!('id' in data) || data.id is string)
          && (!('reason' in data) || data.reason is string)
          && (!('totalCost' in data) || data.totalCost is number)
          && (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp || data.createdAt == null)
          && (!('resolvedAt' in data) || data.resolvedAt is string || data.resolvedAt is timestamp || data.resolvedAt == null)
          && (!('resolvedBy' in data) || data.resolvedBy is string || data.resolvedBy == null)
          && (!('adminNote' in data) || data.adminNote is string);
    }

    function isValidSupplier(data) {
      return data.name is string && data.name.size() > 0
          && data.phone is string && data.phone.size() > 0
          && (!('contactName' in data) || data.contactName is string || data.contactName == null)
          && (!('email' in data) || data.email is string || data.email == null)
          && (!('address' in data) || data.address is string || data.address == null)
          && (!('debt' in data) || data.debt is number)
          && (!('id' in data) || data.id is string)
          && (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string || data.createdAt == null);
    }

    function isValidSupplierImport(data) {
      return data.supplierId is string && data.supplierId.size() > 0
          && data.equipmentId is string && data.equipmentId.size() > 0
          && data.quantity is number && data.quantity >= 0
          && data.unitPrice is number && data.unitPrice >= 0
          && data.totalAmount is number && data.totalAmount >= 0
          && (!('supplierName' in data) || data.supplierName is string)
          && (!('brand' in data) || data.brand is string)
          && (!('model' in data) || data.model is string)
          && (!('paidAmount' in data) || data.paidAmount is number)
          && (!('debtAmount' in data) || data.debtAmount is number)
          && (!('createdById' in data) || data.createdById is string)
          && (!('createdByName' in data) || data.createdByName is string)
          && (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string || data.createdAt == null)
          && (!('note' in data) || data.note is string)
          && (!('id' in data) || data.id is string);
    }

    function isValidInventoryTransaction(data) {
      return data.id is string && data.id.size() > 0
          && data.type in ['import', 'export']
          && data.date is string && data.date.size() > 0
          && data.partnerId is string && data.partnerId.size() > 0
          && data.partnerName is string && data.partnerName.size() > 0
          && data.items is list
          && data.totalValue is number
          && data.createdBy is string && data.createdBy.size() > 0
          && data.createdByName is string && data.createdByName.size() > 0
          && (!('paidAmount' in data) || data.paidAmount is number)
          && (!('debtAmount' in data) || data.debtAmount is number)
          && (!('note' in data) || data.note is string)
          && (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp || data.createdAt == null);
    }

    function isValidSettings(data) {
      return (!('logoUrl' in data) || data.logoUrl is string)
          && (!('companyName' in data) || data.companyName is string)
          && (!('address' in data) || data.address is string)
          && (!('phone' in data) || data.phone is string)
          && (!('website' in data) || data.website is string)
          && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidNotification(data, auth) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
          && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
          && data.type in ['customer', 'appointment', 'task']
          && data.createdBy is string
          && data.createdByName is string && data.createdByName.size() > 0
          && (!('createdAt' in data) || data.createdAt is timestamp || data.createdAt is string || data.createdAt == null);
    }

    // --- RULES ---

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_test_/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == userId || hAdmin(database, request.auth)) && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && (
          incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'displayName', 'username', 'updatedAt', 'phone', 'region']) ||
          request.auth.token.email == 'trungtruc1907@gmail.com' ||
          request.auth.token.email == 'mrhieu@truongsonsolar.local' ||
          (request.auth.token.email is string && request.auth.token.email.matches('mrhieu@.*'))
        )) ||
        hAdmin(database, request.auth)
      ) && isValidUser(incoming());
    }

    match /notifications/{notifId} {
      allow read: if hActive(database, request.auth);
      allow create: if hActive(database, request.auth) && isValidNotification(incoming(), request.auth);
      allow update, delete: if hActive(database, request.auth) && hAdmin(database, request.auth);
    }

    match /customers/{customerId} {
      allow read: if true;
      allow create: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || incoming().assignedSalesId == request.auth.uid) && isValidCustomer(incoming());
      allow update: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) || 
        (existing().assignedSalesId == request.auth.uid && incoming().assignedSalesId == request.auth.uid)
      ) && isValidCustomer(incoming());
      allow delete: if hActive(database, request.auth) && hAdmin(database, request.auth);

      match /interactions/{interactionId} {
        allow read: if true;
        allow create: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || get(/databases/$(database)/documents/customers/$(customerId)).data.assignedSalesId == request.auth.uid) && isValidInteraction(incoming(), request.auth);
        allow update, delete: if hActive(database, request.auth) && (hAdmin(database, request.auth) || resource.data.userId == request.auth.uid);
      }
    }

    match /{path=**}/reminders/{reminderId} {
      allow read: if isSignedIn();
      allow create: if hActive(database, request.auth) && isValidReminder(incoming());
      allow update: if hActive(database, request.auth) && isValidReminder(incoming());
      allow delete: if hActive(database, request.auth);
    }

    match /equipment/{equipmentId} {
      allow read: if true;
      allow create, update: if hActive(database, request.auth) && isValidEquipment(incoming());
      allow delete: if hActive(database, request.auth) && (hAdmin(database, request.auth) || hAccountant(database, request.auth) || hOperator(database, request.auth));
    }

    match /suppliers/{supplierId} {
      allow read: if hActive(database, request.auth);
      allow create, update: if hActive(database, request.auth) && isValidSupplier(incoming());
      allow delete: if hActive(database, request.auth) && (hAdmin(database, request.auth) || hAccountant(database, request.auth) || hOperator(database, request.auth));
    }

    match /supplier_imports/{importId} {
      allow read: if hActive(database, request.auth);
      allow create, update: if hActive(database, request.auth) && isValidSupplierImport(incoming());
      allow delete: if hActive(database, request.auth) && (hAdmin(database, request.auth) || hAccountant(database, request.auth) || hOperator(database, request.auth));
    }

    match /material_requests/{requestId} {
      allow read: if hActive(database, request.auth);
      allow create: if hActive(database, request.auth) && isValidMaterialRequest(incoming());
      allow update: if hActive(database, request.auth) && isValidMaterialRequest(incoming());
      allow delete: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) || 
        hAccountant(database, request.auth) || 
        hOperator(database, request.auth) || 
        resource.data.status == 'draft'
      );
    }

    match /purchase_proposals/{proposalId} {
      allow read: if hActive(database, request.auth);
      allow create, update: if hActive(database, request.auth) && isValidPurchaseProposal(incoming());
      allow delete: if hActive(database, request.auth) && hAdmin(database, request.auth);
    }

    match /inventory_transactions/{txId} {
      allow read: if hActive(database, request.auth);
      allow create, update: if hActive(database, request.auth) && isValidInventoryTransaction(incoming());
      allow delete: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) || 
        hAccountant(database, request.auth) || 
        hOperator(database, request.auth)
      );
    }

    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || incoming().assignedSalesId == request.auth.uid) && isValidProject(incoming());
      allow update: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) || 
        hOperator(database, request.auth) ||
        (existing().assignedSalesId == request.auth.uid && incoming().assignedSalesId == request.auth.uid)
      ) && isValidProject(incoming());
      allow delete: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) ||
        hOperator(database, request.auth) ||
        resource.data.assignedSalesId == request.auth.uid
      );
    }

    function isValidProjectTask(data, auth) {
      return isValidId(data.projectId)
          && data.title is string && data.title.size() > 0
          && data.status in ['todo', 'in_progress', 'review', 'done']
          && (!('assignedToId' in data) || isValidId(data.assignedToId))
          && data.creatorId == auth.uid;
    }

    match /projectTasks/{taskId} {
      allow read: if hActive(database, request.auth);
      allow create: if hActive(database, request.auth) && (!isSalesRep(database, request.auth) || incoming().assignedToId == request.auth.uid) && isValidProjectTask(incoming(), request.auth);
      allow update: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) || 
        hOperator(database, request.auth) ||
        (existing().assignedToId == request.auth.uid && incoming().assignedToId == request.auth.uid)
      );
      allow delete: if hActive(database, request.auth) && (
        hAdmin(database, request.auth) || 
        (!isSalesRep(database, request.auth) && resource.data.creatorId == request.auth.uid)
      );
    }

    function isValidProjectActivity(data, auth) {
      return isValidId(data.projectId)
          && data.userId == auth.uid
          && data.type in ['status_change', 'task_update', 'comment', 'file_upload']
          && data.description is string && data.description.size() > 0;
    }

    match /projectActivities/{activityId} {
      allow read: if hActive(database, request.auth);
      allow create: if hActive(database, request.auth) && isValidProjectActivity(incoming(), request.auth);
      allow update, delete: if false; // Activities are immutable logs
    }

    match /sales/{salesId} {
      allow read: if hActive(database, request.auth);
      allow create: if hActive(database, request.auth) && hAdmin(database, request.auth) && isValidSalesPerson(incoming());
      allow update: if hActive(database, request.auth) && hAdmin(database, request.auth) && isValidSalesPerson(incoming());
      allow delete: if hActive(database, request.auth) && hAdmin(database, request.auth);
    }

    match /salesTasks/{taskId} {
      allow read: if hActive(database, request.auth);
      allow create: if hActive(database, request.auth) && isValidSalesTask(incoming());
      allow update: if hActive(database, request.auth) && isValidSalesTask(incoming());
      allow delete: if hActive(database, request.auth) && hAdmin(database, request.auth);
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && (
        docId != 'general' ||
        (hActive(database, request.auth) && hAdmin(database, request.auth) && isValidSettings(incoming()))
      );
    }
  }
}
