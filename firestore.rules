rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- VALIDATION BLUEPRINTS ---
    
    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 20
          && (!('usageType' in data) || data.usageType in ['residential', 'commercial', 'industrial'])
          && (!('phaseType' in data) || data.phaseType in ['1phase', '3phase'])
          && (!('email' in data) || data.email is string)
          && (!('address' in data) || data.address is string)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('createdAt' in data) || data.createdAt is timestamp)
          && (!('id' in data) || data.id is string);
    }

    function isValidEquipment(data) {
      return data.brand is string && data.brand.size() > 0
          && data.model is string && data.model.size() > 0
          && data.type in ['panel', 'inverter', 'battery', 'mounting', 'accessory', 'other']
          && data.unitPrice is number && data.unitPrice >= 0
          && (!('capacity' in data) || data.capacity is number)
          && (!('id' in data) || data.id is string);
    }

    function isValidProject(data) {
      return isValidId(data.customerId)
          && data.status in ['lead', 'survey', 'proposal', 'contract', 'installation', 'completed']
          && (data.systemSizeKWp is number || (data.systemSizeKWp is string && (data.systemSizeKWp == "" || data.systemSizeKWp == "0")))
          && (!('monthlyBill' in data) || data.monthlyBill is number)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('totalCost' in data) || data.totalCost is number)
          && (!('annualProduction' in data) || data.annualProduction is number)
          && (!('paybackYears' in data) || data.paybackYears is number)
          && (!('panels' in data) || (data.panels.equipmentId is string && data.panels.count is number))
          && (!('inverters' in data) || (data.inverters.equipmentId is string && data.inverters.count is number))
          && (!('batteries' in data) || (data.batteries.equipmentId is string && data.batteries.count is number))
          && (!('updatedAt' in data) || data.updatedAt is timestamp)
          && (!('id' in data) || data.id is string);
    }

    function isValidSalesPerson(data) {
      return data.name is string && data.name.size() > 0
          && data.email is string && data.email.size() > 0
          && data.role in ['sales_rep', 'sales_manager']
          && (!('phone' in data) || data.phone is string)
          && (!('id' in data) || data.id is string)
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidSalesTask(data) {
      return isValidId(data.projectId)
          && data.title is string && data.title.size() > 0
          && data.status in ['pending', 'completed']
          && (!('description' in data) || data.description is string)
          && (!('assignedSalesId' in data) || isValidId(data.assignedSalesId) || data.assignedSalesId == "")
          && (!('id' in data) || data.id is string)
          && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidUser(data) {
      return data.username is string && data.username.size() > 0
          && data.email is string && data.email.size() > 0
          && data.role in ['admin', 'manager', 'sales_rep', 'operator']
          && data.status in ['active', 'inactive', 'pending']
          && (!('displayName' in data) || data.displayName is string)
          && (!('phone' in data) || data.phone is string)
          && (!('region' in data) || data.region is string)
          && (!('createdAt' in data) || data.createdAt is timestamp)
          && (!('lastLogin' in data) || data.lastLogin is timestamp || data.lastLogin == null)
          && (!('updatedAt' in data) || data.updatedAt is timestamp || data.updatedAt == null)
          && (!('id' in data) || data.id is string);
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActive() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // --- RULES ---

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_test_/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'displayName', 'username', 'updatedAt', 'phone', 'region'])) ||
        isAdmin()
      ) && isValidUser(incoming());
    }

    match /customers/{customerId} {
      allow read: if isActive();
      allow create: if isActive() && isValidCustomer(incoming());
      allow update: if isActive() && isValidCustomer(incoming());
      allow delete: if isAdmin();
    }

    match /equipment/{equipmentId} {
      allow read: if isSignedIn(); // Require sign in even for catalog
      allow write: if isActive() && isAdmin() && isValidEquipment(incoming());
    }

    match /projects/{projectId} {
      allow read: if isActive() && (isAdmin() || resource.data.assignedSalesId == request.auth.uid);
      allow create: if isActive() && isValidProject(incoming()) && (isAdmin() || incoming().assignedSalesId == request.auth.uid);
      allow update: if isActive() && isValidProject(incoming()) && (isAdmin() || (existing().assignedSalesId == request.auth.uid && incoming().assignedSalesId == existing().assignedSalesId));
      allow delete: if isActive() && isAdmin();
    }

    function isValidProjectTask(data) {
      return isValidId(data.projectId)
          && data.title is string && data.title.size() > 0
          && data.status in ['todo', 'in_progress', 'review', 'done']
          && (!('assignedToId' in data) || isValidId(data.assignedToId))
          && data.creatorId == request.auth.uid;
    }

    match /projectTasks/{taskId} {
      allow read: if isActive();
      allow create: if isActive() && isValidProjectTask(incoming());
      allow update: if isActive() && (isAdmin() || resource.data.creatorId == request.auth.uid || resource.data.assignedToId == request.auth.uid);
      allow delete: if isActive() && (isAdmin() || resource.data.creatorId == request.auth.uid);
    }

    function isValidProjectActivity(data) {
      return isValidId(data.projectId)
          && data.userId == request.auth.uid
          && data.type in ['status_change', 'task_update', 'comment', 'file_upload']
          && data.description is string && data.description.size() > 0;
    }

    match /projectActivities/{activityId} {
      allow read: if isActive();
      allow create: if isActive() && isValidProjectActivity(incoming());
      allow update, delete: if false; // Activities are immutable logs
    }

    match /sales/{salesId} {
      allow read: if isActive();
      allow create: if isActive() && isAdmin() && isValidSalesPerson(incoming());
      allow update: if isActive() && isAdmin() && isValidSalesPerson(incoming());
      allow delete: if isActive() && isAdmin();
    }

    match /salesTasks/{taskId} {
      allow read: if isActive();
      allow create: if isActive() && isValidSalesTask(incoming());
      allow update: if isActive() && isValidSalesTask(incoming());
      allow delete: if isActive() && isAdmin();
    }
  }
}
